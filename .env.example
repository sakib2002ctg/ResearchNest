# Copy to the ignored root .env. Generate SECRET_KEY with
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Generate each distinct DB password with secrets.token_hex(32), or
# URI-percent-encode reserved characters in other database passwords.
SECRET_KEY=
POSTGRES_PASSWORD=
APP_DATABASE_PASSWORD=
MIGRATION_DATABASE_PASSWORD=
CORS_ORIGINS=["https://research.example.invalid"]
NEXT_PUBLIC_API_BASE_URL=https://api.example.invalid/api/v1
# External services needed before enabling public PDF/email flows.
CLAMAV_HOST=
CLAMAV_PORT=3310
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
