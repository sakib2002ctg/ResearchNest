DATABASE_URL=postgresql://postgres:postgres@db:5432/researchnest

APP_NAME=ResearchNest

DEBUG=True
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
IDENTITY_REQUEST_LIMIT=5
IDENTITY_REQUEST_WINDOW_SECONDS=600

# Required for identity email delivery. STARTTLS defaults to 587, implicit TLS to 465.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=ResearchNest <noreply@example.com>
# SMTP_USERNAME=noreply@example.com
# SMTP_PASSWORD=replace-with-your-smtp-password
# SMTP_USE_SSL=False

SECRET_KEY=replace-with-your-secret-key

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30
