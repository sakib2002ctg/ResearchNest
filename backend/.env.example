DATABASE_URL=postgresql://postgres:postgres@db:5432/researchnest

APP_NAME=ResearchNest

DEBUG=True
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
IDENTITY_REQUEST_LIMIT=5
IDENTITY_REQUEST_WINDOW_SECONDS=600

# Private PDF storage. Set CLAMAV_HOST for staging and production uploads.
# PDF_STORAGE_ROOT=storage/pdfs
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_SECONDS=10

# Choose the vector profile before applying Phase 05 migrations. Keep it fixed.
PGVECTOR_ENABLED=False
# Async indexing defaults to a local in-process worker; a standalone worker can
# run with python -m app.modules.documents.worker.
DOCUMENT_WORKER_IN_API=True
DOCUMENT_EMBEDDING_PROVIDER=hash
# DOCUMENT_EMBEDDING_MODEL_PATH=/path/to/preinstalled/sentence-transformers-model

# Discovery cache and upstream credentials
# REDIS_URL=redis://localhost:6379/0
# Enable before migrating a pgvector-backed PostgreSQL database. Keep this
# setting unchanged for that database; plain PostgreSQL uses portable JSON.
# PGVECTOR_ENABLED=True
# OPENALEX_API_KEY=replace-with-your-openalex-key
# SEMANTIC_SCHOLAR_API_KEY=replace-with-your-semantic-scholar-key
# PUBMED_TOOL_EMAIL=researchnest-operator@example.com
# PUBMED_API_KEY=replace-with-your-ncbi-key

# Required for identity email delivery. STARTTLS defaults to 587, implicit TLS to 465.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=ResearchNest <noreply@example.com>
# SMTP_USERNAME=noreply@example.com
# SMTP_PASSWORD=replace-with-your-smtp-password
# SMTP_USE_SSL=False

SECRET_KEY=replace-with-your-secret-key

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30

# Private AI assistant: deterministic source excerpts by default; no model downloads.
AI_DEFAULT_PROVIDER=offline
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# LOCAL_AI_PROTOCOL=openai enables a local llama.cpp OpenAI-compatible server.
LOCAL_AI_PROTOCOL=ollama
CLOUD_AI_BASE_URL=https://api.openai.com/v1
CLOUD_AI_MODEL=gpt-4.1-mini
# CLOUD_AI_API_KEY=configure-in-your-secret-manager
# Cloud routing additionally requires the user's allow_external_ai consent.
AI_HOURLY_REQUEST_LIMIT=20
AI_DAILY_REQUEST_LIMIT=100
AI_HOURLY_TOKEN_LIMIT=100000
AI_DAILY_TOKEN_LIMIT=200000
AI_MAX_CONCURRENT_REQUESTS=1
AI_MAX_COMPLETION_TOKENS=800
AI_MIN_RELEVANCE=0.18
ANALYSIS_MAX_COMPLETION_TOKENS=4096

# Multimodal crops stay outside the public web root, partitioned by authenticated owner.
ASSET_STORAGE_ROOT=storage/assets
MULTIMODAL_WORKER_IN_API=True
OLLAMA_VISION_MODEL=llama3.2-vision
CLOUD_VISION_MODEL=gpt-4.1-mini
