# Historical reference only. Compose now supplies an explicit environment map.
# Supply credentials through an untracked root .env or your secret manager.
# See ../.env.example and ../README.md. No credential is stored in this file.
APP_NAME=ResearchNest
APP_ENV=production
DEBUG=false
PGVECTOR_ENABLED=true
DOCUMENT_WORKER_IN_API=false
MULTIMODAL_WORKER_IN_API=false
